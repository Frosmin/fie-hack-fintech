  "voice": {
    "tone": [
      "cercano",
      "claro",
      "breve",
      "inclusivo"
    ],
    "avoid": [
      "tono autoritario",
      "lenguaje excluyente",
      "estetica fintech generica",
      "dark mode por defecto"
    ]
  },
  "ai_rules": {
    "must": [
      "Use Avenir-based typography.",
      "Use blue and magenta as dominant brand colors.",
      "Prefer rounded controls and soft panels.",
      "Design mobile-first.",
      "Keep reports simple and readable."
    ],
    "must_not": [
      "Do not default to Inter.",
      "Do not use random purple-heavy palettes.",
      "Do not design a cold enterprise banking UI.",
      "Do not use dark dashboards by default."
    ]
  }
