      "blue": "#005BA7",
      "blueDeep": "#2B4382",
      "blueMid": "#364DAB",
      "magenta": "#EE008A",
      "magentaSoft": "#E1278D",
      "magentaAlt": "#E02C88",
      "cyan": "#44C2F4"
    },
    "surface": {
