{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/api"
    }
  },
  "functions": {
    "backend/src/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "backend/src/generated/prisma/**"
    }
  },
  "rewrites": []
}
