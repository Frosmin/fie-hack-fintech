{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --dir frontend --frozen-lockfile && pnpm install --dir backend --frozen-lockfile",
  "buildCommand": "pnpm --dir frontend build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "backend/src/generated/prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
